# Orders, Admin routes (EP-38..EP-43). Catalog section 7. All AdminOnly: a Customer gets 403 on every
# /orders route (customers use /customers/me/orders, see my-orders/my-orders.http).
# Stretch EP-44 (delete order) and the Idempotency-Key header are not built and not covered.
# Needs: api-tests/scripts/Initialize-LocalHttpEnv.ps1. Run top to bottom.
# Visual Studio: send loginAdmin, loginCustomerA, meCustomerA, createProduct, createOrder and getOrder first.
# Flow: product (stock 100) -> order 1 Pending -> replace items (If-Match) -> Confirmed -> Shipped -> Completed;
# order 2 Pending -> cancel. No order is left Pending (the cap is 5 open Pending orders per customer).
# Cleanup: completed and cancelled orders stay (rows are never deleted) and so does their product, so the
# order lines keep a live product.

### POST Auth - Login Admin
# @name loginAdmin
# @expect 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### POST Auth - Login Customer A
# @name loginCustomerA
# @expect 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerAEmail}}",
  "password": "{{customerAPassword}}"
}

### GET Auth - Me as Customer A (customer ID for the order)
# @name meCustomerA
# @expect 200
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Products - Setup for orders (EP-24)
# @name createProduct
# @expect 201
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test order product {{$randomInt 1000 9999}}",
  "sku": "T-{{$randomInt 100000 999999}}",
  "price": 12.50,
  "stockQuantity": 100
}

### POST Orders - Valid (EP-38)
# 201 OrderResponse with Location /api/v1/orders/{id} and ETag. Status Pending, stock reserved.
# @name createOrder
# @expect 201
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "customerId": "{{meCustomerA.response.body.$.customerId}}",
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 2 }
  ]
}

### GET Orders - By id (EP-40)
# Items, history and allowedNextStatuses, plus ETag.
# @name getOrder
# @expect 200
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - By id from Location (EP-40)
# @expect 200
GET {{baseUrl}}{{createOrder.response.headers.Location}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - By id as Customer (EP-40)
# ID routes are Admin only: 403, even for the customer's own order.
# @expect 403
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Orders - By id without token (EP-40)
# @expect 401
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}

### GET Orders - Unknown id (EP-40)
# @expect 404
GET {{baseUrl}}/api/v1/orders/{{$guid}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - Malformed id (EP-40)
# @expect 400
GET {{baseUrl}}/api/v1/orders/not-a-guid
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - List (EP-39)
# @expect 200
GET {{baseUrl}}/api/v1/orders?page=1&pageSize=20&sort=-createdAt
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - List with filters (EP-39)
# status is repeatable.
# @expect 200
GET {{baseUrl}}/api/v1/orders?status=Pending&status=Confirmed&customerId={{meCustomerA.response.body.$.customerId}}&createdFrom=2026-01-01T00:00:00Z&minTotal=0&maxTotal=1000
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - List invalid status and sort (EP-39)
# @expect 400
GET {{baseUrl}}/api/v1/orders?status=Lost&sort=customerName
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - List minTotal above maxTotal (EP-39)
# @expect 400
GET {{baseUrl}}/api/v1/orders?minTotal=100&maxTotal=1
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Orders - List as Customer (EP-39)
# @expect 403
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Orders - List without token (EP-39)
# @expect 401
GET {{baseUrl}}/api/v1/orders

### POST Orders - Insufficient stock (EP-38)
# 409 insufficient-stock with productIds (stock is 100, minus 2 reserved).
# @expect 409
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "customerId": "{{meCustomerA.response.body.$.customerId}}",
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 1000 }
  ]
}

### POST Orders - Unknown product (EP-38)
