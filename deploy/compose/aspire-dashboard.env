# Standalone Aspire dashboard (compose profile `observability`, ADR-0013). No secrets in this file.
# UI login: browser token printed in the container log (`docker compose logs aspire-dashboard`).
DASHBOARD__FRONTEND__AUTHMODE=BrowserToken
# OTLP gRPC on 18889 is reachable only inside the compose network (not published).
DASHBOARD__OTLP__AUTHMODE=Unsecured
DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS=false
