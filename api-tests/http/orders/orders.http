### DELETE Customers - Customer with an open order (EP-33)
# 409 customer-has-open-orders: Customer A has a Pending order. Nothing is deleted.
# @expect 409
DELETE {{baseUrl}}/api/v1/customers/{{meCustomerA.response.body.$.customerId}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### PUT Orders - Replace items with If-Match (EP-41)
# @name replaceItems
# @expect 200
PUT {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}/items
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{getOrder.response.headers.ETag}}
Content-Type: application/json

{
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 3 }
  ]
}

### PUT Orders - Replace items missing If-Match (EP-41)
# @expect 428
PUT {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}/items
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 1 }
  ]
}

