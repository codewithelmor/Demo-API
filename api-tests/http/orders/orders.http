POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "customerId": "{{meCustomerA.response.body.$.customerId}}",
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 1 }
  ]
}

### POST Orders - Cancel as Customer (EP-43)
# @expect 403
POST {{baseUrl}}/api/v1/orders/{{createOrderToCancel.response.body.$.id}}/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Orders - Cancel without token (EP-43)
# @expect 401
POST {{baseUrl}}/api/v1/orders/{{createOrderToCancel.response.body.$.id}}/cancel

### POST Orders - Cancel unknown order (EP-43)
# @expect 404
POST {{baseUrl}}/api/v1/orders/{{$guid}}/cancel
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### POST Orders - Cancel reason too long (EP-43)
# @expect 400
POST {{baseUrl}}/api/v1/orders/{{createOrderToCancel.response.body.$.id}}/cancel
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "reason": ""
}

### POST Orders - Cancel with a reason (EP-43)
# Pending to Cancelled; stock is returned. The body is optional.
# @expect 204
POST {{baseUrl}}/api/v1/orders/{{createOrderToCancel.response.body.$.id}}/cancel
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "reason": "API test cleanup"
}

### POST Orders - Cancel again without a body (EP-43)
# Already Cancelled: 409 invalid-status-transition.
# @expect 409
POST {{baseUrl}}/api/v1/orders/{{createOrderToCancel.response.body.$.id}}/cancel
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

# The product is not deleted here: the orders above keep pointing at it, and a deleted product makes the
# order lines show "Product no longer available" for the Customer (404 on the name lookup). EP-26 delete is
# covered in products/products.http.
