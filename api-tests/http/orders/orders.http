### PUT Orders - Replace items when not Pending (EP-41)
# 409 invalid-order-state (current ETag, so the If-Match check passes).
# @expect 409
PUT {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}/items
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{getConfirmedOrder.response.headers.ETag}}
Content-Type: application/json

{
  "items": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 1 }
  ]
}

