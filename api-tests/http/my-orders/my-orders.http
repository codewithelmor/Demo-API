### POST Customers me orders - Cancel other customer's order (EP-48, BOLA)
# Customer B cancels Customer A's order: 404 before any 409, and nothing changes.
# @expect 404
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrder.response.body.$.id}}/cancel
Authorization: Bearer {{loginCustomerB.response.body.$.accessToken}}

### POST Customers me orders - Cancel unknown order (EP-48)
# @expect 404
POST {{baseUrl}}/api/v1/customers/me/orders/{{$guid}}/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Customers me orders - Cancel malformed id (EP-48)
# 400 errors.orderId (D7).
# @expect 400
POST {{baseUrl}}/api/v1/customers/me/orders/not-a-guid/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Customers me orders - Cancel as Admin (EP-48)
# @expect 403
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrder.response.body.$.id}}/cancel
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### POST Customers me orders - Cancel without token (EP-48)
# @expect 401
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrder.response.body.$.id}}/cancel

### POST Customers me orders - Cancel with a reason (EP-48)
# Pending to Cancelled; stock is returned.
# @expect 204
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrder.response.body.$.id}}/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}
Content-Type: application/json

{
  "reason": "API test cleanup"
}

### POST Customers me orders - Cancel again (EP-48)
# Only Pending orders can be cancelled: 409 invalid-status-transition.
# @expect 409
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrder.response.body.$.id}}/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Customers me orders - Cancel without a body - Cleanup (EP-48)
# @expect 204
POST {{baseUrl}}/api/v1/customers/me/orders/{{placeMyOrderWithCustomerId.response.body.$.id}}/cancel
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### DELETE Products - Cleanup (EP-26)
# @expect 204
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
