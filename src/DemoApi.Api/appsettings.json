{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Valkey": ""
  },
  "Jwt": {
    "Issuer": "demoapi",
    "Audience": "demoapi",
    "KeyId": "k1",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshFamilyDays": 30
  },
  "App": {
    "CurrencyCode": "USD",
    "MaxPendingOrders": 5,
    "LowStockThreshold": 10
  },
  "RateLimiting": {
    "AuthStrict": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "General": { "PermitLimit": 300, "AnonymousPermitLimit": 60, "WindowSeconds": 60 },
    "ReportsConcurrency": 4
  },
  "Email": {
    "LinkBaseUrl": "http://localhost:8080"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SeedAdmin": {
    "Enabled": true,
    "Email": "admin@demoapi.local"
  }
}
