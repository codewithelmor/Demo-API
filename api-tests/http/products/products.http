# Products (EP-22..EP-27). Catalog section 5. Reads: Authenticated. Writes: AdminOnly.
# Stretch EP-28 (stock adjustments) is not built and not covered.
# Needs: api-tests/scripts/Initialize-LocalHttpEnv.ps1. Run top to bottom.
# Visual Studio: send loginAdmin, loginCustomerA and createProduct first.
# Flow: create, read, list, update (If-Match), negative cases, delete, restore, delete again (cleanup).

### POST Auth - Login Admin
# @name loginAdmin
# @expect 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### POST Auth - Login Customer A
# @name loginCustomerA
# @expect 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerAEmail}}",
  "password": "{{customerAPassword}}"
}

### POST Products - Valid (EP-24)
# 201 with Location and ETag. SKU is stored upper-case.
# @name createProduct
# @expect 201
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test product {{$randomInt 1000 9999}}",
  "sku": "t-{{$randomInt 100000 999999}}",
  "description": "Generated by the API tests.",
  "price": 19.99,
  "stockQuantity": 100
}

### GET Products - By id as Admin (EP-23)
# @name getProduct
# @expect 200
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Products - By id from Location as Customer (EP-23)
# Customer response has no isDeleted. Cache-Control: private, no-cache.
# @expect 200
GET {{baseUrl}}{{createProduct.response.headers.Location}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - List as Customer (EP-22)
# @expect 200
GET {{baseUrl}}/api/v1/products?page=1&pageSize=20&sort=name
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - List with filters as Admin (EP-22)
# @expect 200
GET {{baseUrl}}/api/v1/products?search={{createProduct.response.body.$.sku}}&minPrice=1&maxPrice=100&inStock=true&sort=-price,name
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Products - List invalid sort field (EP-22)
# 400 errors.sort lists the allowed fields.
# @expect 400
GET {{baseUrl}}/api/v1/products?sort=cost
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - List minPrice above maxPrice (EP-22)
# @expect 400
GET {{baseUrl}}/api/v1/products?minPrice=50&maxPrice=10
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - List search too short (EP-22)
# @expect 400
GET {{baseUrl}}/api/v1/products?search=a
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - List without token (EP-22)
# @expect 401
GET {{baseUrl}}/api/v1/products

### GET Products - By id without token (EP-23)
# @expect 401
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}

### GET Products - Unknown id (EP-23)
# @expect 404
GET {{baseUrl}}/api/v1/products/{{$guid}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - Malformed id (EP-23)
# 400 errors.productId (D7).
# @expect 400
GET {{baseUrl}}/api/v1/products/not-a-guid
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### PUT Products - Valid with If-Match (EP-25)
# Full replace. Returns the product with a new ETag.
# @name updateProduct
# @expect 200
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{getProduct.response.headers.ETag}}
Content-Type: application/json

{
  "name": "Test product updated {{$randomInt 1000 9999}}",
  "sku": "{{createProduct.response.body.$.sku}}",
  "description": "Updated by the API tests.",
  "price": 24.50,
  "stockQuantity": 100
}

### PUT Products - Missing If-Match (EP-25)
# 428 precondition-required.
# @expect 428
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 24.50,
  "stockQuantity": 100
}

### PUT Products - If-Match star counts as missing (EP-25)
# @expect 428
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: *
Content-Type: application/json

{
  "name": "Test product",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 24.50,
  "stockQuantity": 100
}

### PUT Products - Stale ETag (EP-25)
# The ETag from before the update is stale: 412 precondition-failed.
# @expect 412
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{getProduct.response.headers.ETag}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 24.50,
  "stockQuantity": 100
}

### PUT Products - Invalid fields (EP-25)
# 400: price with 3 decimals, invalid SKU characters, negative stock.
# @expect 400
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{updateProduct.response.headers.ETag}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "bad sku!",
  "price": 1.999,
  "stockQuantity": -1
}

### PUT Products - Unknown id (EP-25)
# @expect 404
PUT {{baseUrl}}/api/v1/products/{{$guid}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
If-Match: {{updateProduct.response.headers.ETag}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "T-1",
  "price": 1.00,
  "stockQuantity": 1
}

### PUT Products - As Customer (EP-25)
# @expect 403
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}
If-Match: {{updateProduct.response.headers.ETag}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 0.01,
  "stockQuantity": 100
}

### PUT Products - Without token (EP-25)
# @expect 401
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 0.01,
  "stockQuantity": 100
}

### POST Products - Duplicate SKU (EP-24)
# 409 duplicate-sku (case-insensitive: the SKU was sent lower-case and stored upper-case).
# @expect 409
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test product duplicate",
  "sku": "{{createProduct.response.body.$.sku}}",
  "price": 5.00,
  "stockQuantity": 1
}

### POST Products - Invalid fields (EP-24)
# @expect 400
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "",
  "sku": "",
  "price": 0,
  "stockQuantity": 1000001
}

### POST Products - Price as string (EP-24)
# Wrong JSON type: 400, not 500.
# @expect 400
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "T-{{$randomInt 100000 999999}}",
  "price": "cheap",
  "stockQuantity": 1
}

### POST Products - Not JSON (EP-24)
# 415 unsupported-media-type.
# @expect 415
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: text/plain

name=Test

### POST Products - As Customer (EP-24)
# @expect 403
POST {{baseUrl}}/api/v1/products
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Test product",
  "sku": "T-{{$randomInt 100000 999999}}",
  "price": 5.00,
  "stockQuantity": 1
}

### POST Products - Without token (EP-24)
# @expect 401
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "Test product",
  "sku": "T-{{$randomInt 100000 999999}}",
  "price": 5.00,
  "stockQuantity": 1
}

### POST Products - Restore an active product (EP-27)
# 409 not-deleted.
# @expect 409
POST {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}/restore
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### DELETE Products - As Customer (EP-26)
# @expect 403
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### DELETE Products - Without token (EP-26)
# @expect 401
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}

### DELETE Products - Unknown id (EP-26)
# @expect 404
DELETE {{baseUrl}}/api/v1/products/{{$guid}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### DELETE Products - Valid (EP-26)
# Soft delete.
# @expect 204
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Products - Deleted as Customer (EP-23)
# @expect 404
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - Deleted as Customer with includeDeleted (EP-23)
# includeDeleted is ignored for Customers: still 404.
# @expect 404
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}?includeDeleted=true
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### GET Products - Deleted as Admin with includeDeleted (EP-23)
# 200 with isDeleted true (bypasses the cache).
# @expect 200
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}?includeDeleted=true
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### DELETE Products - Already deleted (EP-26)
# @expect 404
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### POST Products - Restore as Customer (EP-27)
# @expect 403
POST {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}/restore
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### POST Products - Restore without token (EP-27)
# @expect 401
POST {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}/restore

### POST Products - Restore unknown id (EP-27)
# @expect 404
POST {{baseUrl}}/api/v1/products/{{$guid}}/restore
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### POST Products - Restore (EP-27)
# @expect 204
POST {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}/restore
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Products - Restored as Customer (EP-23)
# @expect 200
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomerA.response.body.$.accessToken}}

### DELETE Products - Cleanup (EP-26)
# @expect 204
DELETE {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### GET Products - Deleted after cleanup (EP-23)
# @expect 404
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
