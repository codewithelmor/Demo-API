# syntax=docker/dockerfile:1
# Orders web image: React SPA served by the ASP.NET Core BFF on one origin (ADR-0015, frontend-architecture section 4).
#   docker build -f deploy/docker/Dockerfile.web -t demoapi/web:dev .
# Build context = repository root. The API Dockerfile (deploy/docker/Dockerfile) is not used or changed.
# Node is a build tool only; the final image has no Node, no shell, and runs as the non-root chiseled user.

# node:26.12.1-alpine, multi-arch index digest resolved 2026-10-31. Refresh the digest with the Node patch version.
ARG NODE_IMAGE=node:26.12.1-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797
ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.402-noble
ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.13-noble-chiseled

# ---------- 1. SPA build (Node, build time only) ----------
FROM ${NODE_IMAGE} AS spa
ENV CI=true
WORKDIR /spa
# .npmrc: save-exact, engine-strict, min-release-age, ignore-scripts. Lockfile first so this layer caches.
COPY web/spa/package.json web/spa/package-lock.json web/spa/.npmrc web/spa/.nvmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/spa/ ./
RUN npm run build

# ---------- 2. BFF publish (locked restore) ----------
FROM ${SDK_IMAGE} AS bff
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
WORKDIR /repo
# web/Directory.*.props import the root files, so those (and the analyzer inputs) are needed for restore and build.
COPY global.json nuget.config Directory.Build.props Directory.Packages.props BannedSymbols.txt .editorconfig ./
COPY web/Directory.Build.props web/Directory.Packages.props web/
COPY web/DemoApi.Bff/DemoApi.Bff.csproj web/DemoApi.Bff/packages.lock.json web/DemoApi.Bff/
RUN dotnet restore web/DemoApi.Bff/DemoApi.Bff.csproj --locked-mode
COPY web/DemoApi.Bff/ web/DemoApi.Bff/
RUN dotnet publish web/DemoApi.Bff/DemoApi.Bff.csproj -c Release -o /out/app --no-restore -p:UseAppHost=false \
 && mkdir -p /out/dp-keys

# ---------- 3. runtime (chiseled, non-root, HTTP 8080) ----------
FROM ${RUNTIME_IMAGE} AS final
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
# Mount point for the Data Protection key ring volume (bff-dp-keys); owned by the app user so a new volume is writable.
COPY --from=bff --chown=$APP_UID:$APP_UID /out/dp-keys /var/lib/demoapi-bff/dp-keys
COPY --from=bff --chown=root:root /out/app ./
# The SPA build output is the BFF's static root (served by UseSpaStaticFiles, index.html as fallback).
COPY --from=spa --chown=root:root /spa/dist ./wwwroot
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "DemoApi.Bff.dll"]
